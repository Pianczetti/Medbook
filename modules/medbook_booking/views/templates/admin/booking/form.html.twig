{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
  <div class="row">
    <div class="col">
      <div class="card">
        <div class="card-header">
          <h3 class="card-header-title">{{ 'Booking'|trans({}, 'Modules.Medbookbooking.Admin') }}</h3>
        </div>
        <div class="card-body">
          {{ form_start(bookingForm) }}
            {{ form_row(bookingForm.id_resource) }}
            {{ form_row(bookingForm.booking_date) }}
            {{ form_row(bookingForm.time_start) }}
            {{ form_row(bookingForm.time_end) }}
            {{ form_row(bookingForm.status) }}
            {{ form_row(bookingForm.customer_name) }}
            {{ form_row(bookingForm.customer_email) }}
            {{ form_row(bookingForm.customer_phone) }}
            {{ form_row(bookingForm.notes) }}
            {{ form_row(bookingForm.no_show) }}
            {{ form_row(bookingForm.admin_notes) }}
            <button type="submit" class="btn btn-primary">
              {{ 'Save'|trans({}, 'Admin.Actions') }}
            </button>
            <a href="{{ path('admin_medbook_booking_booking_index') }}" class="btn btn-outline-secondary">
              {{ 'Cancel'|trans({}, 'Admin.Actions') }}
            </a>
          {{ form_end(bookingForm) }}
        </div>
      </div>
    </div>
  </div>
{% endblock %}
