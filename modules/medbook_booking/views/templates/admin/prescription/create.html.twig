{% extends '@Modules/medbook_booking/views/templates/admin/layout.html.twig' %}

{% block content %}
    <div class="card">
        <div class="card-header">
            <h3 class="card-header-title">Nowa recepta (rezerwacja #{{ bookingId }})</h3>
        </div>
        <div class="card-body">
            {{ form_start(prescriptionForm) }}
                {{ form_widget(prescriptionForm) }}
                <button type="submit" class="btn btn-primary">Zapisz recepte</button>
                <a href="{{ path('admin_medbook_booking_prescription_list', {bookingId: bookingId}) }}" class="btn btn-secondary">Anuluj</a>
            {{ form_end(prescriptionForm) }}
        </div>
    </div>
{% endblock %}
